package web

import (
	"encoding/json"
	"fmt"
	"hjplus-desktop-agent/internal/tools"
	"net/http"
	"net/url"
	"sort"
	"strings"
	"sync"
	"time"
)

// SearchProcurementTenders 搜尋政府電子採購網的招標資訊
func SearchProcurementTenders(env *tools.Environment, ctx WebContext, sessionID string, query string, page int) (string, error) {
	env.Logger.Info("WebIO: Searching Procurement Tenders: %s (Page: %d, Session: %s)", query, page, sessionID)

	// 1. 執行初步搜尋
	baseURL := "https://pcc-api.openfun.app/api/searchbytitle"
	u, _ := url.Parse(baseURL)
	q := u.Query()
	q.Set("query", query)
	if page > 0 {
		q.Set("page", fmt.Sprintf("%d", page))
	}
	u.RawQuery = q.Encode()
	u.RawQuery = strings.ReplaceAll(u.RawQuery, "+", "%20")

	client := &http.Client{Timeout: 15 * time.Second}
	resp, err := client.Get(u.String())
	if err != nil {
		return "", fmt.Errorf("search error: %v", err)
	}
	defer resp.Body.Close()

	var searchData struct {
		Records []map[string]interface{} `json:"records"`
	}
	if err := json.NewDecoder(resp.Body).Decode(&searchData); err != nil {
		return "", fmt.Errorf("decode search results error: %v", err)
	}

	// 2. 過濾招標類別
	var filteredRecords []map[string]interface{}
	for _, rec := range searchData.Records {
		brief, ok := rec["brief"].(map[string]interface{})
		if ok {
			tType, _ := brief["type"].(string)
			if tType == "公開招標" || tType == "選擇性招標(建立資格名單)" {
				filteredRecords = append(filteredRecords, rec)
			}
		}
	}

	// 排序：日期由新到舊
	sort.Slice(filteredRecords, func(i, j int) bool {
		dateI, _ := filteredRecords[i]["date"].(float64)
		dateJ, _ := filteredRecords[j]["date"].(float64)
		return dateI > dateJ
	})

	if len(filteredRecords) == 0 {
		return "未找到符合「公開招標」或「選擇性招標」且狀態為「辦理中」的標案。", nil
	}

	// 3. 獲取詳細資訊 (限制 20 筆)
	limit := 20
	if len(filteredRecords) < limit {
		limit = len(filteredRecords)
	}

	type EnrichedItem struct {
		Index  int
		Record map[string]interface{}
		Detail map[string]interface{}
	}
	enrichedResults := make([]EnrichedItem, limit)
	var wg sync.WaitGroup
	var mu sync.Mutex

	for i := 0; i < limit; i++ {
		wg.Add(1)
		go func(idx int) {
			defer wg.Done()
			rec := filteredRecords[idx]
			unitID, _ := rec["unit_id"].(string)
			jobNum, _ := rec["job_number"].(string)
			searchDate, _ := rec["date"].(float64)
			searchFilename, _ := rec["filename"].(string)

			if unitID == "" || jobNum == "" {
				mu.Lock()
				enrichedResults[idx] = EnrichedItem{Index: idx, Record: rec}
				mu.Unlock()
				return
			}

			detailURL := fmt.Sprintf("https://pcc-api.openfun.app/api/tender?unit_id=%s&job_number=%s", unitID, jobNum)
			dResp, err := client.Get(detailURL)
			if err == nil {
				defer dResp.Body.Close()
				var dData struct {
					Records []map[string]interface{} `json:"records"`
				}
				if err := json.NewDecoder(dResp.Body).Decode(&dData); err == nil {
					var matchedDetail map[string]interface{}
					for _, r := range dData.Records {
						rDate, _ := r["date"].(float64)
						rFilename, _ := r["filename"].(string)
						if rDate == searchDate && rFilename == searchFilename {
							matchedDetail, _ = r["detail"].(map[string]interface{})
							break
						}
					}
					if matchedDetail == nil && len(dData.Records) > 0 {
						matchedDetail, _ = dData.Records[0]["detail"].(map[string]interface{})
					}

					mu.Lock()
					enrichedResults[idx] = EnrichedItem{Index: idx, Record: rec, Detail: matchedDetail}
					mu.Unlock()
					return
				}
			}
			mu.Lock()
			enrichedResults[idx] = EnrichedItem{Index: idx, Record: rec}
			mu.Unlock()
		}(i)
	}
	wg.Wait()

	// 日期解析函數：處理 ROC 日期格式
	parseProcurementDate := func(s string) (time.Time, bool) {
		s = strings.TrimSpace(s)
		if s == "" {
			return time.Time{}, false
		}
		parts := strings.Split(s, "/")
		if len(parts) < 3 {
			return time.Time{}, false
		}
		var rocYear int
		fmt.Sscanf(parts[0], "%d", &rocYear)
		gregYear := rocYear + 1911

		remaining := strings.Join(parts[1:], "/")
		t, err := time.ParseInLocation("01/02 15:04", remaining, time.Local)
		if err != nil {
			t, err = time.ParseInLocation("01/02", remaining, time.Local)
			if err != nil {
				return time.Time{}, false
			}
		}
		return time.Date(gregYear, t.Month(), t.Day(), t.Hour(), t.Minute(), 0, 0, time.Local), true
	}

	// 4. 格式化輸出
	var sb strings.Builder
	sb.WriteString("| 公告日期 | 截止投標 | 剩餘天數 | 招標類別 | 標案案號 | 標案名稱 | 預算金額 | 決標概況 | 連結 |\n")
	sb.WriteString("| :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- |\n")

	now := time.Now()
	activeCount := 0

	for _, res := range enrichedResults {
		detail := res.Detail
		if detail == nil {
			continue
		}

		deadlineStr, _ := detail["截止投標:截止投標時間"].(string)
		deadlineTime, ok := parseProcurementDate(deadlineStr)
		if ok && now.After(deadlineTime) {
			continue
		}

		remainingStr := "-"
		if ok {
			diff := deadlineTime.Sub(now)
			days := int(diff.Hours() / 24)
			if days == 0 && diff.Hours() > 0 {
				remainingStr = "今日截止"
			} else if days > 0 {
				remainingStr = fmt.Sprintf("%d 天", days)
			} else {
				remainingStr = "即將截止"
			}
		}

		brief, _ := res.Record["brief"].(map[string]interface{})
		tType, _ := brief["type"].(string)
		if tType == "" {
			tType, _ = detail["招標資訊:招標方式"].(string)
		}

		uID, _ := res.Record["unit_id"].(string)
		jNum, _ := res.Record["job_number"].(string)
		date, _ := res.Record["date"].(float64)
		filename, _ := res.Record["filename"].(string)

		caseID, _ := detail["招標資訊:標案案號"].(string)
		title, _ := detail["招標資訊:標案名稱"].(string)
		budget, _ := detail["招標資訊:預算金額"].(string)
		award, _ := detail["決標資訊:決標方式"].(string)
		pccURL, _ := detail["url"].(string)
		publishDate, _ := detail["招標資訊:公告日期"].(string)

		if caseID == "" {
			caseID = jNum
		}
		if title == "" {
			title, _ = brief["title"].(string)
		}
		if pccURL == "" {
			pccURL = fmt.Sprintf("https://openfunltd.github.io/pcc-viewer/tender.html?unit_id=%s&job_number=%s&date=%.0f&filename=%s", uID, jNum, date, filename)
		}

		sanitize := func(s string) string {
			s = strings.ReplaceAll(s, "|", "\\|")
			s = strings.ReplaceAll(s, "\n", " ")
			return strings.TrimSpace(s)
		}

		line := fmt.Sprintf("| %s | %s | **%s** | %s | %s | %s | %s | %s | [查看標案](%s) |\n",
			sanitize(publishDate), sanitize(deadlineStr), sanitize(remainingStr), sanitize(tType), sanitize(caseID), sanitize(title), sanitize(budget), sanitize(award), pccURL)
		sb.WriteString(line)
		activeCount++
	}

	content := sb.String()

	if sessionID != "" {
		ctx.AutoRecord(sessionID, "SearchProcurementTenders", content, map[string]interface{}{
			"query":   query,
			"page":    page,
			"total":   len(filteredRecords),
			"active":  activeCount,
			"scanned": limit,
		})
	}

	result := "> [!NOTE]\n> **PCC Smart Search**: 已根據您的需求過濾招標中標案，以下為目前最符合的 %d 筆標案（已掃描 %d 筆）：\n\n%s"
	return fmt.Sprintf(result, activeCount, limit, content), nil
}
